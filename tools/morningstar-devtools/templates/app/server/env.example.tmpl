# Copy to .env (which git ignores) and fill in. Never commit a real value.

# Where the server listens. 127.0.0.1 reaches a phone over USB through
# `adb reverse tcp:{{port}} tcp:{{port}}`; use 0.0.0.0 only behind a proxy.
HOST=127.0.0.1
PORT={{port}}

# Optional. When set, every request but the health check must carry
# `Authorization: Bearer <this>`. Leave empty on a development machine.
APP_TOKEN=

# Requests a device may make in a minute.
RATE_LIMIT_PER_MINUTE=60
