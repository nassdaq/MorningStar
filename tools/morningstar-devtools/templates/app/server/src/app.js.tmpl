// The request pipeline and the routes. `createApp` takes what it depends
// on as arguments, so the tests run it with a clock of their own.
//
// The contract is API.md: change both together.

import { createHash, timingSafeEqual } from 'node:crypto';

const DEVICE_ID = /^[A-Za-z0-9_-]{8,64}$/;
const BODY_LIMIT = 16 * 1024;
const NAME_LIMIT = 40;

/** An answer that is an error: `{"error": {"code", "message"}}`. */
export class HttpError extends Error {
  constructor(status, code, message, headers = {}) {
    super(message);
    this.status = status;
    this.code = code;
    this.headers = headers;
  }
}

function sameToken(given, expected) {
  const a = createHash('sha256').update(given).digest();
  const b = createHash('sha256').update(expected).digest();
  return timingSafeEqual(a, b);
}

/** At most `limit` requests a minute for each key; `take` answers the seconds to wait. */
export function createRateLimiter({ limit, now }) {
  const windows = new Map();
  return {
    take(key) {
      const at = now();
      let window = windows.get(key);
      if (!window || at - window.start >= 60000) {
        window = { start: at, count: 0 };
        windows.set(key, window);
      }
      if (window.count >= limit) return Math.max(1, Math.ceil((window.start + 60000 - at) / 1000));
      window.count += 1;
      return 0;
    },
    sweep() {
      const at = now();
      for (const [key, window] of windows) if (at - window.start >= 60000) windows.delete(key);
    },
  };
}

async function readJson(req) {
  const chunks = [];
  let size = 0;
  for await (const chunk of req) {
    size += chunk.length;
    if (size > BODY_LIMIT) throw new HttpError(413, 'too_large', 'The request body is too large.');
    chunks.push(chunk);
  }
  if (!size) return {};
  try {
    const value = JSON.parse(Buffer.concat(chunks).toString('utf8'));
    if (value && typeof value === 'object' && !Array.isArray(value)) return value;
  } catch {
    // Falls through to the error below.
  }
  throw new HttpError(400, 'bad_request', 'The body must be a JSON object.');
}

function sendJson(res, status, json, headers = {}) {
  const body = JSON.stringify(json);
  res.writeHead(status, {
    'Content-Type': 'application/json; charset=utf-8',
    'Content-Length': Buffer.byteLength(body),
    'Cache-Control': 'no-store',
    ...headers,
  });
  res.end(body);
}

export function createApp({ config, log = console, now = Date.now, background = true }) {
  const limiter = createRateLimiter({ limit: config.rateLimitPerMinute, now });
  // The example resource's state: how often each device said hello. It is
  // in memory, so it is gone when the server restarts; a real resource
  // belongs in a database.
  const hellos = new Map();

  let sweeper = null;
  if (background) {
    sweeper = setInterval(() => limiter.sweep(), 60000);
    sweeper.unref();
  }

  // method + path -> { open, handler }. `open` routes need no device id.
  const routes = new Map([
    ['GET /v1/health', { open: true, handler: async () => ({ status: 200, json: { ok: true } }) }],
    [
      'GET /v1/hello',
      { handler: async ({ deviceId }) => ({ status: 200, json: { count: hellos.get(deviceId) ?? 0 } }) },
    ],
    [
      'POST /v1/hello',
      {
        handler: async ({ req, deviceId }) => {
          const body = await readJson(req);
          const name = body.name === undefined ? '' : body.name;
          if (typeof name !== 'string' || name.length > NAME_LIMIT) {
            throw new HttpError(400, 'bad_request', `"name" must be a string of at most ${NAME_LIMIT} characters.`);
          }
          const count = (hellos.get(deviceId) ?? 0) + 1;
          hellos.set(deviceId, count);
          const who = name.trim() ? `, ${name.trim()}` : '';
          return { status: 200, json: { message: `Hello${who}. That is ${count} from this phone.`, count } };
        },
      },
    ],
  ]);

  async function respond(req, res, path) {
    const route = routes.get(`${req.method} ${path}`);
    if (!route) {
      const known = [...routes.keys()].some((key) => key.endsWith(` ${path}`));
      if (known) throw new HttpError(405, 'method_not_allowed', 'That method is not allowed here.');
      throw new HttpError(404, 'not_found', 'There is nothing at that address.');
    }
    let deviceId = null;
    if (!route.open) {
      if (config.appToken) {
        const header = String(req.headers.authorization ?? '');
        const given = header.startsWith('Bearer ') ? header.slice(7).trim() : '';
        if (!given || !sameToken(given, config.appToken)) {
          throw new HttpError(401, 'unauthorized', 'A valid token is required.');
        }
      }
      deviceId = String(req.headers['x-device-id'] ?? '');
      if (!DEVICE_ID.test(deviceId)) {
        throw new HttpError(400, 'bad_request', 'The X-Device-Id header must be 8 to 64 characters of A-Z, a-z, 0-9, _ or -.');
      }
      const wait = limiter.take(deviceId);
      if (wait > 0) {
        throw new HttpError(429, 'rate_limited', `Too many requests. Try again in ${wait} seconds.`, { 'Retry-After': String(wait) });
      }
    }
    const result = await route.handler({ req, deviceId });
    sendJson(res, result.status, result.json);
  }

  /** The `http.Server` request listener. Never rejects. */
  async function handle(req, res) {
    const started = performance.now();
    let path = '/';
    try {
      path = new URL(req.url ?? '/', 'http://localhost').pathname;
    } catch {
      // Left as "/": answered 404 below.
    }
    try {
      await respond(req, res, path);
    } catch (error) {
      if (error instanceof HttpError) {
        sendJson(res, error.status, { error: { code: error.code, message: error.message } }, error.headers);
      } else {
        log.error(`unhandled error on ${req.method} ${path}`, error);
        sendJson(res, 500, { error: { code: 'internal_error', message: 'Something went wrong on the server.' } });
      }
    }
    // The path only: never a header, a body or a token.
    log.info(`${req.method} ${path} ${res.statusCode} ${Math.round(performance.now() - started)}ms`);
  }

  return { handle, close: () => clearInterval(sweeper) };
}
