# CallReady server configuration. Copy to `.env` and fill in; `.env` is
# git-ignored and must never be committed. Variables already set in the
# environment take precedence over this file.

# PostgreSQL connection URL. Use sslmode=require (the certificate is verified).
# The server creates and uses only tables prefixed `callready_`.
DATABASE_URL=

# DeepSeek API key (https://platform.deepseek.com). Required: it plays the
# caller and scores the call.
DEEPSEEK_API_KEY=

# ElevenLabs API key. Optional: leave empty to run calls in text only.
# The key needs access to Text to Speech, Speech to Text and Voices (read).
ELEVENLABS_API_KEY=

# Where to listen. HOST defaults to 127.0.0.1; set 0.0.0.0 only on purpose.
PORT=8787
# HOST=127.0.0.1

# If set, every request must carry `Authorization: Bearer <APP_TOKEN>`.
# APP_TOKEN=

# Model name sent to DeepSeek. `deepseek-chat` is accepted by the API and is
# served by its current fast model; `deepseek-flash` names that model directly.
# DEEPSEEK_MODEL=deepseek-chat

# ElevenLabs models and output format.
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64

# Voice ids to use for an accent instead of the one chosen from the account's
# voice list by accent label.
# ELEVENLABS_VOICE_US=
# ELEVENLABS_VOICE_UK=
# ELEVENLABS_VOICE_AUSTRALIAN=
# ELEVENLABS_VOICE_INDIAN=

# Requests allowed per device per minute (429 beyond it).
# RATE_LIMIT_PER_MIN=60

# IANA time zone whose midnight separates the days of the practice streak.
# STREAK_TZ=UTC

# For tests and proxies only: where the two services are reached.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
