# Copy to .env (which git ignores) and fill in. Nothing here is ever logged.

# PostgreSQL. Only tables prefixed atlas_ are created or touched.
DATABASE_URL=

# The language model (https://platform.deepseek.com).
DEEPSEEK_API_KEY=

# Optional: speech in and out (https://elevenlabs.io). Without it the app's
# live voice stays a demo and answers are text only.
ELEVENLABS_API_KEY=

# Optional: require "Authorization: Bearer <token>" on every request.
APP_TOKEN=

# Where to listen. 8788, so that it runs beside the CallReady server (8787).
HOST=127.0.0.1
PORT=8788

# Optional overrides (the defaults are in src/config.js).
DEEPSEEK_MODEL_FAST=
DEEPSEEK_MODEL_SMART=
DEEPSEEK_MODEL_CODE=
DEEPSEEK_SMART_EFFORT=
ELEVENLABS_VOICE=
