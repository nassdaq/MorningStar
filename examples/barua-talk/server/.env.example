# Copy to .env (which git ignores) and fill in. Nothing here is ever logged.

# PostgreSQL. Only tables prefixed barua_talk_ are created or touched.
DATABASE_URL=

# The Barua Talk API key (Settings → API in the Barua workspace; scopes
# talk:read and talk:write). Without it the server still starts: health
# says talk: false, and everything that needs upstream answers
# 503 talk_unavailable.
BARUA_API_KEY=

# Phone calls cost TSh 300 a minute, the app cannot join their audio yet,
# and upstream documents no way to hang one up. They stay off unless this
# is "on".
PHONE_CALLS=

# Optional: the caller id for phone calls (one of the workspace's voice
# numbers, E.164). Empty: upstream uses the workspace's first.
BARUA_CALLER_ID=

# Optional: "delete" if upstream answers DELETE /calls/{id}; the server can
# then hang up phone calls. Its document lists no such endpoint.
BARUA_PHONE_HANGUP=

# Optional: require "Authorization: Bearer <token>" on every request.
APP_TOKEN=

# Where to listen. 8789, so that it runs beside the CallReady (8787) and
# Atlas (8788) servers.
HOST=127.0.0.1
PORT=8789

# Optional overrides (the defaults are in src/config.js).
BARUA_API_BASE=
BARUA_REQUESTS_PER_MIN=
RECORDING_MAX_MINUTES=
RING_TIMEOUT_SECONDS=
RATE_LIMIT_PER_MIN=
